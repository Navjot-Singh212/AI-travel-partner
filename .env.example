# Explore Local - Environment Variables
# Copy this file to .env.local to configure your local development environment:
# cp .env.example .env.local

# Gemini API Key (Server-side only, NEVER in browser code)
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model is gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

